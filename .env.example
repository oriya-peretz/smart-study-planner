# Copy to .env (git-ignored). Never commit real keys.

# The model as <provider>:<model>. "test" needs no key, network or cost.
AI_MODEL=test

# For a local model, such as AI_MODEL=ollama:<tag>
# OLLAMA_BASE_URL=http://localhost:11434/v1

# For a hosted model, such as AI_MODEL=openai:<model-id>
# OPENAI_API_KEY=your-key-here

# The wall-clock limit on the model, in seconds.
AI_TIMEOUT_SECONDS=25

# Hides the Pydantic AI startup banner.
PYDANTIC_AI_NO_BANNER=1
